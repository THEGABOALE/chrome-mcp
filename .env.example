# Transport used by the MCP server: "stdio" or "http"
TRANSPORT=stdio

# Optional path to the Chrome executable. If unset, the launcher will try to
# discover Chrome automatically.
CHROME_PATH=

# Dedicated user-data-dir for the automated Chrome instance. Chrome 136+
# refuses to attach the DevTools protocol to the default profile, so this
# must point at a separate directory used only by chrome-mcp.
CHROME_USER_DATA_DIR=C:\chrome-mcp-profile

# Port used for the Chrome DevTools Protocol (--remote-debugging-port).
CDP_PORT=9222

# Total budget (ms) to keep retrying the CDP connection after launching Chrome,
# using exponential backoff, before giving up.
CDP_CONNECT_TIMEOUT_MS=10000

# Comma-separated list of domains the browser tools are allowed to navigate
# to/interact with. Leave empty to allow all domains.
ALLOWED_DOMAINS=

# Whether tools that evaluate arbitrary JS in the page are enabled.
ALLOW_EVAL=false

# Default timeout (ms) applied to browser operations (navigation, waits, etc).
DEFAULT_TIMEOUT_MS=30000

# Maximum number of characters returned by content-extraction tools before
# truncation.
MAX_CONTENT_CHARS=20000
